# Optional local defaults: copy this file to e2e/.env.local and uncomment only
# what you need. Standard installations and CI need no local configuration.
# Use ${VARIABLE:-default} so command-line environment overrides still win.

# E2E_HEADLESS="${E2E_HEADLESS:-1}"
# E2E_ANDROID_SERIAL="${E2E_ANDROID_SERIAL:-emulator-5554}"
# E2E_ANDROID_TARGET="${E2E_ANDROID_TARGET:-google_apis}"
# E2E_BACKEND_URL="${E2E_BACKEND_URL:-http://127.0.0.1:8888}"

# Custom Android tooling (only if your tools use nonstandard ADB settings):
# E2E_ADB_SERVER_PORT="${E2E_ADB_SERVER_PORT:-5037}"
# E2E_MAESTRO_HOME="${E2E_MAESTRO_HOME:-$HOME/.cache/e2e/adb-home}"
# Maestro's direct adbd endpoint, NOT the host ADB-server port:
# E2E_MAESTRO_ADB_HOST="${E2E_MAESTRO_ADB_HOST:-127.0.0.1}"
# E2E_MAESTRO_ADB_PORT="${E2E_MAESTRO_ADB_PORT:-5555}"
